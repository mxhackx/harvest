# Variables du site. Les vraies valeurs sont dans Doppler (projet hivation-web ; voir README).
# Les NEXT_PUBLIC_* sont lues à la compilation et VISIBLES DANS LE NAVIGATEUR : jamais de secret.

# ---------- Local (valeurs par défaut si absentes) ----------
# Adresse de l'API. Défaut : http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Adresse de la vitrine (liens canoniques, sitemap, aperçus de partage). Défaut : http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Facultatif : un domaine par partie. À laisser absents en local (ils activent les redirections) ----------
# NEXT_PUBLIC_APP_URL=https://app.hivation.tech
# NEXT_PUBLIC_DOCS_URL=https://docs.hivation.tech
# NEXT_PUBLIC_CMS_URL=https://cms.hivation.tech

# ---------- Facultatif : relais /api quand le site et l'API ne partagent pas le même domaine ----------
# Mettre alors NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=https://mon-api.onrender.com

# ---------- Facultatif : tests de bout en bout (hors Doppler) ----------
# CHROME_PATH=/usr/bin/google-chrome
# E2E_DATABASE_URL=postgres://harvest:harvest@localhost:54329/harvest_test

# Registre de composants du CMS. Défaut : http://localhost:3001 en développement (npm run registry:dev), https://ui.hivation.tech en production.
# NEXT_PUBLIC_REGISTRY_URL=
