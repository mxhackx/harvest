# Adresse de l API (développement)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Adresse publique du site (liens canoniques, sitemap, image de partage)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production : domaine de l'application (même déploiement que le site). Le proxy renvoie /dashboard, /login, /invitation…
# vers ce domaine, et la racine et /docs vers NEXT_PUBLIC_SITE_URL. Vide en développement : un seul domaine.
# NEXT_PUBLIC_APP_URL=https://app.hivation.tech

# Production (Vercel + Render) : le site relaie /api/* vers l API, pour que le cookie de session reste un cookie du site.
# NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=https://harvest-api.onrender.com
