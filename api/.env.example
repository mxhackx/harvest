PORT=4000

# URL publique de l'API (sert aux callbacks OAuth)
API_URL=http://localhost:4000

# Origines autorisées (CORS), séparées par des virgules. La première est la redirection par défaut.
APP_URLS=http://localhost:3000

# Supabase : Project Settings > Database > Connection string > « Session pooler » (port 5432).
# Pas le pooler en mode transaction (6543) : les migrations demandent une session. SSL activé automatiquement.
# Local : postgres://harvest:harvest@localhost:54329/harvest (scripts/db-local.sh start)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# OAuth Google — callback : ${API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth GitHub — callback : ${API_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# E-mails (invitations, mot de passe oublié) via Resend. Sans clé, rien n'est envoyé : les liens s'affichent à l'écran.
# Tant qu'aucun domaine n'est vérifié chez Resend, l'expéditeur par défaut n'écrit qu'à l'adresse du compte Resend.
RESEND_API_KEY=
MAIL_FROM=Harvest <onboarding@resend.dev>
