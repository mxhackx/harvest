# Variables de l'API. Les vraies valeurs sont dans Doppler (projet hivation-api ; voir README).
# Ce fichier liste tout ce que l'API lit. Aucune valeur secrète ici.

# ---------- Obligatoire ----------
# Local (scripts/db-local.sh start) : postgres://harvest:harvest@localhost:54329/harvest
# Supabase : Project Settings > Database > Connection string > « Session pooler » (port 5432).
# Pas le pooler en mode transaction (6543) : les migrations demandent une session. SSL activé automatiquement.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# ---------- Adresses (valeurs locales par défaut) ----------
# Port d'écoute. Défaut : 4000 (fourni par l'hébergeur en ligne).
PORT=4000
# URL publique de l'API, vue par le navigateur (retours Google / GitHub). Défaut : RENDER_EXTERNAL_URL, sinon http://localhost:4000
API_URL=http://localhost:4000
# Origines autorisées (CORS), séparées par des virgules. L'application EN PREMIER (liens des e-mails, retour de connexion).
# Production : https://app.hivation.tech,https://www.hivation.tech,https://docs.hivation.tech,https://cms.hivation.tech
APP_URLS=http://localhost:3000

# ---------- Facultatif : connexion Google / GitHub (vide = désactivée) ----------
# Retour à déclarer chez Google : ${API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Retour à déclarer chez GitHub : ${API_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---------- Facultatif : e-mails (Resend) ----------
# Sans clé, rien n'est envoyé : les liens s'affichent à l'écran. Conseillé vide en local.
RESEND_API_KEY=
# Sans domaine vérifié chez Resend, l'expéditeur par défaut n'écrit qu'à l'adresse du compte Resend.
MAIL_FROM=Hivation <onboarding@resend.dev>
# Reçoit les messages de la bulle de contact de la documentation. Vide : ils sont seulement gardés en base.
SUPPORT_EMAIL=

# ---------- Facultatif : services de cartes (des adresses et coordonnées leur sont envoyées) ----------
# Itinéraires des tournées (OSRM). Absent : serveur public de démonstration. « off » : estimation en ligne droite.
# ROUTING_URL=off
# Géocodage des adresses. « off » : aucun appel.
# GEOCODING=off
# Service de géocodage. Absent : https://nominatim.openstreetmap.org
# GEOCODER_URL=

# ---------- En ligne seulement ----------
# « production » active le cookie sécurisé et la confiance au proxy. Ne pas définir en local.
# NODE_ENV=production
# Version de Node utilisée par Render.
# NODE_VERSION=22

# ---------- Facultatif : pièces jointes (Supabase Storage). Absentes : la fonction est indisponible ----------
# Adresse du projet, ex. https://xxxx.supabase.co (ce n'est pas DATABASE_URL)
SUPABASE_URL=
# Clé secrète (sb_secret_…). Elle ignore les règles RLS : serveur uniquement, jamais dans le web ni dans Git.
SUPABASE_SECRET_KEY=
# Bucket PRIVÉ. Défaut : attachments
# SUPABASE_BUCKET=attachments
