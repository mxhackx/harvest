    "children": [
     {
      "type": "text",
      "name": "Texte",
      "props": {},
      "text": "Titre de la carte",
      "textStyle": "label"
     },
     {
      "type": "text",
      "name": "Texte",
      "props": {
       "opacity": 0.65,
       "fontSize": 14
      },
      "text": "Une courte description.",
      "textStyle": "body"
     }
    ]
   },
   {
    "type": "text",
    "name": "Texte",
    "props": {},
