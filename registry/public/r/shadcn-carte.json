     },
     {
      "type": "button",
      "name": "Bouton",
      "props": {
       "radius": 8,
       "paddingY": 9,
       "paddingX": 16,
       "fontSize": 14,
       "fontWeight": 500,
       "borderWidth": 1,
       "background": "$texte",
       "color": "$fond",
       "borderColor": "$texte"
      },
      "text": "Confirmer",
      "href": "#"
     }
    ]
   }
  ]
 },
